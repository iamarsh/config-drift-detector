# AWS Configuration
AWS_ACCOUNT_ID=your_aws_account_id
AWS_REGION=us-east-2
S3_BUCKET_NAME=config-drift-snapshots-your_account_id

# IAM Role (Lambda execution)
LAMBDA_ROLE_ARN=arn:aws:iam::your_account_id:role/lambda-config-drift-detector-role

# AWS Secrets Manager
AWS_SECRETS_MANAGER_ARN=arn:aws:secretsmanager:region:account_id:secret:config-drift-detector/aws-credentials-xxxxx
LAMBDA_ARN_SECRET_ARN=arn:aws:secretsmanager:region:account_id:secret:config-drift-detector/lambda-arn-xxxxx

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# GitHub (for CI/CD)
GITHUB_TOKEN=your_github_token
GITHUB_REPO=your_username/config-drift-detector
GITHUB_USER_NAME=Your Name
GITHUB_USER_EMAIL=your.email@example.com

# Application
NODE_ENV=development
LOG_LEVEL=info
